# GOMBUONE — Variáveis de ambiente (modelo, SEM valores reais)
# Copiar para .env e preencher com os valores corretos.

# Neon PostgreSQL (Serverless) — connection string com sslmode=require
# Exemplo: postgresql://usuario:senha@ep-xxx-pooler.região.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Senha master do painel administrativo (gerar com: openssl rand -hex 16)
# Usada para autenticar em /admin/login e assinar as sessões administrativas
ADMIN_MASTER_PASSWORD=""

# Token de leitura/escrita do Vercel Blob (criado automaticamente ao ligar
# o Blob Store ao projeto na Vercel) — NUNCA exposto ao cliente
BLOB_READ_WRITE_TOKEN=""
